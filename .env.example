# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Settings
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
ALLOWED_ADMIN_IPS=127.0.0.1,::1

# AWS SES & Infrastructure
NEXT_PUBLIC_AWS_REGION=eu-central-1
NEXT_PUBLIC_ACCESS_KEY_ID=your-aws-access-key-id
NEXT_PUBLIC_SECRET_ACCESS_KEY=your-aws-secret-access-key
NEXT_PUBLIC_SENDER_EMAIL=noreply@yourdomain.com
